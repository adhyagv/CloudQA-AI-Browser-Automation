GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=your_configured_model
BROWSER_HEADED=false
BROWSER_NAVIGATION_TIMEOUT_MS=10000
BROWSER_ACTION_TIMEOUT_MS=5000
SNAPSHOT_MAX_ELEMENTS=60
SNAPSHOT_TEXT_LENGTH=120
BROWSER_STALE_RETRY_ATTEMPTS=1
PLANNER_MAX_STEPS=10
PLANNER_CORRECTION_ATTEMPTS=2
MAX_PLANNER_CALLS=4
ALLOWED_SECRET_NAMES=LOGIN_PASSWORD
# Set each allowed secret as a separate environment variable; never put its value here.
